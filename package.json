{
  "name": "bcker-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev --turbo",
    "dev:frontend:wp": "next dev",
    "dev:backend": "convex dev --until-success",
    "predev": "convex dashboard",
    "build": "next build",
    "build:t": "next build --turbo",
    "build:wp": "next build",
    "start": "next start",
    "sync-lang-en": "ts-node scripts/i18n/syncEnJson.ts",
    "sync-env": "scripts/sync-vercel-env.sh",
    "analyze": "ANALYZE=true pnpm run build",
    "analyze:t": "ANALYZE=true pnpm run build:turbo",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate:supabase": "supabase db push",
    "env:dev": "scripts/setup-env.sh development && pnpm dev",
    "env:staging": "scripts/setup-env.sh staging",
    "env:prod": "scripts/setup-env.sh production",
    "env:validate": "tsx scripts/validate-env.ts",
    "env:switch": "scripts/setup-env.sh",
    "dev:with-env": "pnpm env:validate && pnpm dev",
    "build:staging": "pnpm env:staging && pnpm build",
    "build:prod": "pnpm env:prod && pnpm build"
  },
